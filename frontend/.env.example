# Semua nilai VITE_* bersifat PUBLIK (ikut ke bundel browser). Jangan taruh rahasia di sini.
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_NAME=Gain Circle Reservasi
# true = pakai backend tiruan di browser (hanya dev/demo). UI menampilkan lencana "DATA CONTOH".
VITE_USE_MOCKS=false
VITE_MAIN_SITE_URL=https://gaincoffeecircle.com
VITE_INSTAGRAM_URL=https://www.instagram.com/gain.circle/
VITE_MAPS_URL=https://www.google.com/maps/search/?api=1&query=Gain+Circle+Coffee+Jl.+Pacar+No.+2+Surabaya
